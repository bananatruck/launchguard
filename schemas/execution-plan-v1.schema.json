{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchguard.dev/schemas/execution-plan-v1.schema.json",
  "title": "LaunchGuard ExecutionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest",
    "template_version",
    "profile_revision",
    "component_root",
    "framework",
    "deployment_kind",
    "approval_state",
    "commands",
    "network_policy",
    "resource_limits",
    "environment_variables",
    "expected_outputs",
    "health_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1
    },
    "component_root": {
      "type": "string"
    },
    "framework": {
      "enum": ["react_vite", "next_js", "fast_api", "rust_axum"]
    },
    "deployment_kind": {
      "enum": ["static", "server"]
    },
    "approval_state": {
      "const": "requires_approval"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "network_policy": {
      "$ref": "#/$defs/network_policy"
    },
    "resource_limits": {
      "$ref": "#/$defs/resource_limits"
    },
    "environment_variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_variable"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expected_output"
      }
    },
    "health_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/health_check"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "executable",
        "arguments",
        "working_directory",
        "expected_exit_codes",
        "requires_network",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": ["install", "test", "build", "start"]
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string"
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "requires_network": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_deny", "allowed_destinations"],
      "properties": {
        "default_deny": {
          "const": true
        },
        "allowed_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_mib", "pids", "timeout_seconds"],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "evidence_path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "evidence_path": {
          "type": "string"
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "directory"
        }
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "timeout_seconds"],
      "properties": {
        "kind": {
          "enum": ["directory_exists", "http_get"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
