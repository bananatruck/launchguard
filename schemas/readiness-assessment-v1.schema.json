{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchguard.dev/schemas/readiness-assessment-v1.schema.json",
  "title": "LaunchGuard ReadinessAssessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "profile_revision",
    "plan_digest",
    "findings_digest",
    "completed_scanners",
    "checks",
    "scores",
    "blocks_preview",
    "blocks_publication",
    "reproduction_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "findings_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed_scanners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["trivy", "osv_scanner"]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "blocks_preview": {
      "type": "boolean"
    },
    "blocks_publication": {
      "type": "boolean"
    },
    "reproduction_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "passed", "weight", "message"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": ["build", "security", "deployment", "operational"]
        },
        "passed": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned", "possible", "percentage"],
      "properties": {
        "earned": {
          "type": "integer",
          "minimum": 0
        },
        "possible": {
          "type": "integer",
          "minimum": 1
        },
        "percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "security",
        "deployment",
        "operational",
        "overall_percentage"
      ],
      "properties": {
        "build": {
          "$ref": "#/$defs/dimension_score"
        },
        "security": {
          "$ref": "#/$defs/dimension_score"
        },
        "deployment": {
          "$ref": "#/$defs/dimension_score"
        },
        "operational": {
          "$ref": "#/$defs/dimension_score"
        },
        "overall_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
