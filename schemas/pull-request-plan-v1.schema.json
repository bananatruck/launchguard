{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchguard.dev/schemas/pull-request-plan-v1.schema.json",
  "title": "LaunchGuard PullRequestPlan v1",
  "description": "Exactly what publication would push and under what permissions. Content-addressed so approval binds to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","repository","base_branch","head_branch","title","body","files","requested_scopes","revision","intent_digest","decision_digest","digest"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "base_branch": { "type": "string", "minLength": 1 },
    "head_branch": { "type": "string", "pattern": "^launchguard/" },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1 },
    "requested_scopes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "permits"],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "permits": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revision": { "type": "string", "minLength": 1 },
    "intent_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
