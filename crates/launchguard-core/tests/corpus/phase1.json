      }
    },
    {
      "id": "fastapi-pyproject-uv",
      "expected": "fast_api",
      "files": {
        "pyproject.toml": "[project]\ndependencies = [\"fastapi>=0.115\", \"uvicorn\"]\n",
        "uv.lock": "",
        "app/main.py": "from fastapi import FastAPI\napi = FastAPI()\n"
      }
    },
    {
      "id": "fastapi-poetry-nested",
